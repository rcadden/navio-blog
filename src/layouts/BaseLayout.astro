---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  ogType?: string;
  publishDate?: Date;
}

const {
  title,
  description = 'Navio road trip guides — smarter routes, better stops.',
  image = 'https://mynavio.com/navio_og_image.jpg',
  ogType = 'website',
  publishDate,
} = Astro.props;

// Build canonical from the current URL, stripping trailing slash to match
// live URL pattern (trailingSlash: 'never'). Falls back to Astro.url.href
// which already includes site + base when base is configured.
const canonicalURL = (Astro.props.canonicalURL ?? Astro.url.href).replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Tag Manager -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PBDQDPGJ');
    </script>
    <!-- End Google Tag Manager -->
    <!--
      PostHog. Same project as the main Navio app (375399), and because the
      blog is proxied under mynavio.com it is the SAME ORIGIN — so localStorage
      persistence is shared and a reader who clicks through to /planner keeps
      the same distinct_id. That is what makes blog → planner → route_planned
      queryable as one funnel. Config mirrors src/components/PostHogProvider.tsx
      in the Navio repo; keep the two in step.
      Loaded via the async CDN snippet rather than bundling posthog-js, to keep
      the Astro bundle light on content pages where search is the top channel.
    -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_nhMWkhGigRjaoQQez57FoXWqaZZGJGtfrmqssvcTiTYo',{
        api_host: 'https://us.i.posthog.com',
        capture_pageview: true,
        capture_pageleave: true,
        persistence: 'localStorage'
      });
    </script>
    <!-- End PostHog -->
    <title>{title} | Navio</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Navio`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {ogType === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Navio`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="Navio Road Trip Guides" href="https://mynavio.com/blog/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class="bg-white text-gray-900 antialiased min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PBDQDPGJ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <header class="sticky top-0 z-10 bg-white/80 backdrop-blur-md border-b border-gray-100 px-4 sm:px-6 py-3">
      <div class="max-w-4xl mx-auto flex items-center justify-between h-10">
        <a href="https://mynavio.com" class="flex flex-row items-center gap-2.5 no-underline">
          <img
            src="/logo.png"
            alt="Navio logo"
            class="h-8 w-auto object-contain"
            width="32"
            height="32"
          />
          <span class="font-display font-extrabold text-xl tracking-widest uppercase text-gray-900">NAVIO</span>
        </a>
        <nav class="flex items-center gap-4 sm:gap-5">
          <a href="/blog" class="text-sm text-gray-600 hover:text-gray-900 transition-colors hidden sm:block">Road Trips</a>
          <a
            href="https://mynavio.com/planner"
            class="text-sm font-semibold text-white bg-primary px-4 py-2 rounded-lg hover:bg-primary/90 transition-colors"
            data-track="blog_planner_click"
            data-position="header"
          >Plan a Route</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-gray-100 px-6 py-10 mt-auto">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
        <div class="flex items-center gap-2.5">
          <img src="/logo.png" alt="Navio" class="h-5 w-auto opacity-60" width="20" height="20" />
          <span>© {new Date().getFullYear()} Applied Flux, LLC. All rights reserved.</span>
        </div>
        <div class="flex gap-5">
          <a href="https://mynavio.com/privacy" class="hover:text-gray-700 transition-colors">Privacy</a>
          <a href="https://mynavio.com/terms" class="hover:text-gray-700 transition-colors">Terms</a>
          <a
            href="https://mynavio.com/pricing"
            class="hover:text-gray-700 transition-colors"
            data-track="blog_pro_click"
            data-position="footer"
          >Go Pro</a>
        </div>
      </div>
    </footer>

    <!-- Navio click-tracking: delegate data-track attribute clicks to dataLayer -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var el = e.target && e.target.closest('[data-track]');
        if (!el) return;
        var payload = { event: el.dataset.track };
        if (el.dataset.slug) payload.post_slug = el.dataset.slug;
        if (el.dataset.position) payload.position = el.dataset.position;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(payload);
      });
    </script>

  </body>
</html>
