---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('trips', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const {
  title, description, publishDate, heroImage,
  routeId, origin, destination, estimatedDriveTime, distanceMiles, tags,
} = post.data;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const utm = 'utm_source=navio-blog&utm_medium=content';

const plannerUrl = routeId
  ? `https://mynavio.com/share/${routeId}?${utm}`
  : `https://mynavio.com/planner?origin=${encodeURIComponent(origin)}&destination=${encodeURIComponent(destination)}&${utm}`;
---

<BaseLayout title={title} description={description} image={heroImage}>

  <div class="bg-[radial-gradient(circle_at_top_center,rgba(38,92,75,0.07),transparent_60%),radial-gradient(circle_at_bottom_right,rgba(230,167,94,0.06),transparent_50%)] border-b border-gray-100">
    <div class="max-w-3xl mx-auto px-6 py-14">
      <div class="flex items-center gap-2 text-sm text-gray-400 mb-5">
        <a href="/blog/" class="hover:text-primary transition-colors">Road Trips</a>
        <span>›</span>
        <span class="text-gray-500">{origin} → {destination}</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 leading-tight mb-5">{title}</h1>
      <p class="text-xl text-gray-500 leading-relaxed mb-8 max-w-2xl">{description}</p>
      <a
        href={plannerUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex flex-wrap items-center gap-x-4 gap-y-2 bg-white border border-gray-200 rounded-xl px-5 py-3 shadow-sm text-sm hover:border-primary/40 hover:shadow-md transition-all"
      >
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-primary flex-shrink-0"></span>
          <span class="font-medium text-gray-800">{origin}</span>
        </div>
        <span class="text-gray-300 hidden sm:block">──────</span>
        <span class="text-gray-400 sm:hidden">→</span>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-sunset flex-shrink-0"></span>
          <span class="font-medium text-gray-800">{destination}</span>
        </div>
        {estimatedDriveTime && (
          <>
            <span class="text-gray-200 hidden sm:block">|</span>
            <span class="text-gray-500">{estimatedDriveTime}</span>
          </>
        )}
        {distanceMiles && (
          <>
            <span class="text-gray-200 hidden sm:block">|</span>
            <span class="text-gray-500">{distanceMiles} mi</span>
          </>
        )}
        <span class="text-primary text-xs font-medium ml-1">Open in Navio →</span>
      </a>
    </div>
  </div>

  <article class="max-w-3xl mx-auto px-6 py-12">
    {heroImage && (
      <img src={heroImage} alt={title} class="w-full aspect-[16/9] object-cover rounded-xl mb-10 shadow-sm" />
    )}
    <div class="flex flex-wrap items-center gap-3 mb-10 pb-8 border-b border-gray-100">
      <time datetime={publishDate.toISOString()} class="text-sm text-gray-400">{formattedDate}</time>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map(tag => (
            <span class="px-2.5 py-0.5 rounded-full bg-primary/5 border border-primary/15 text-primary text-xs font-medium">{tag}</span>
          ))}
        </div>
      )}
    </div>
    <div class="prose prose-gray prose-lg max-w-none
      prose-headings:font-display prose-headings:font-bold prose-headings:text-gray-900
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-gray-600 prose-p:leading-relaxed
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-strong:text-gray-900
      prose-li:my-1 prose-li:text-gray-600">
      <Content />
    </div>
    <div class="mt-16 p-8 rounded-2xl border border-primary/15 bg-[radial-gradient(circle_at_top_left,rgba(38,92,75,0.05),transparent_60%)]">
      <p class="font-display font-bold text-2xl text-gray-900 mb-2">Ready to hit the road?</p>
      <p class="text-gray-500 mb-6 max-w-md leading-relaxed">
        Open this route in Navio for vehicle-aware stop suggestions, fuel cost estimates, and one-tap Google Maps handoff.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={plannerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-white bg-primary px-6 py-3 rounded-xl hover:bg-primary/90 transition-colors shadow-sm"
        >
          {routeId ? 'Open Route in Navio' : 'Plan This Route in Navio'} →
        </a>
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 bg-white border border-gray-200 px-6 py-3 rounded-xl hover:border-gray-300 transition-colors"
        >
          More Road Trips
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
