---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('trips', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const {
  title, description, publishDate, heroImage,
  routeId, origin, destination, estimatedDriveTime, distanceMiles, tags,
} = post.data;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const utm = 'utm_source=navio-blog&utm_medium=content';

const plannerUrl = routeId
  ? `https://mynavio.com/share/${routeId}?${utm}`
  : `https://mynavio.com/planner?origin=${encodeURIComponent(origin)}&destination=${encodeURIComponent(destination)}&${utm}`;

// Play Store link. The `referrer` param is what Play Console's acquisition
// reports read, so blog-driven installs are attributable per post — it is a
// single URL-encoded string, not ordinary query params.
const playReferrer = encodeURIComponent(
  `utm_source=navio-blog&utm_medium=content&utm_campaign=${post.slug}`
);
const playStoreUrl = `https://play.google.com/store/apps/details?id=com.mynavio.app&referrer=${playReferrer}`;

// Canonical URL: site + base + slug, no trailing slash
const canonicalURL = `https://mynavio.com/blog/${post.slug}`;

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": canonicalURL,
      "headline": title,
      "description": description,
      ...(heroImage ? { "image": heroImage } : {}),
      "datePublished": publishDate.toISOString(),
      "dateModified": publishDate.toISOString(),
      "author": {
        "@type": "Organization",
        "name": "Navio",
        "url": "https://mynavio.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Navio",
        "url": "https://mynavio.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://mynavio.com/logo.png"
        }
      },
      "mainEntityOfPage": canonicalURL
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://mynavio.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Road Trips",
          "item": "https://mynavio.com/blog"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonicalURL
        }
      ]
    }
  ]
};

// FAQ JSON-LD: parse post.body for ## FAQ section and extract Q&A pairs
function parseFaqPairs(body: string): Array<{ question: string; answer: string }> {
  const lines = body.split('\n');
  let faqStart = -1;
  for (let i = 0; i < lines.length; i++) {
    if (/^##\s+(FAQ|FAQs|Frequently Asked Questions)\s*$/.test(lines[i])) {
      faqStart = i + 1;
      break;
    }
  }
  if (faqStart === -1) return [];
  let faqEnd = lines.length;
  for (let i = faqStart; i < lines.length; i++) {
    if (/^##\s+/.test(lines[i]) && !/^###/.test(lines[i])) {
      faqEnd = i;
      break;
    }
  }
  const faqLines = lines.slice(faqStart, faqEnd);
  const pairs: Array<{ question: string; answer: string }> = [];
  let currentQuestion: string | null = null;
  let answerLines: string[] = [];
  function stripMarkdown(text: string): string {
    return text
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/\*{1,3}([^*]+)\*{1,3}/g, '$1')
      .replace(/_{1,3}([^_]+)_{1,3}/g, '$1')
      .replace(/\s+/g, ' ')
      .trim();
  }
  function flushPair() {
    if (currentQuestion !== null) {
      const answerText = stripMarkdown(answerLines.join(' ').trim());
      if (answerText) pairs.push({ question: currentQuestion, answer: answerText });
    }
  }
  for (const line of faqLines) {
    const h3Match = line.match(/^###\s+(.+)$/);
    if (h3Match) { flushPair(); currentQuestion = h3Match[1].trim(); answerLines = []; }
    else if (currentQuestion !== null) { answerLines.push(line); }
  }
  flushPair();
  return pairs;
}

const faqPairs = parseFaqPairs(post.body);

// Emit FAQPage JSON-LD only when >= 2 Q&A pairs are found
const faqJsonLdString = faqPairs.length >= 2
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqPairs.map(({ question, answer }) => ({
        "@type": "Question",
        "name": question,
        "acceptedAnswer": { "@type": "Answer", "text": answer },
      })),
    }).replace(/</g, '\u003c')
  : null;

---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  ogType="article"
  publishDate={publishDate}
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {faqJsonLdString && (
      <script type="application/ld+json" set:html={faqJsonLdString} />
    )}
  </Fragment>

  <div class="bg-[radial-gradient(circle_at_top_center,rgba(38,92,75,0.07),transparent_60%),radial-gradient(circle_at_bottom_right,rgba(230,167,94,0.06),transparent_50%)] border-b border-gray-100">
    <div class="max-w-3xl mx-auto px-6 py-14">
      <div class="flex items-center gap-2 text-sm text-gray-400 mb-5">
        <a href="/blog" class="hover:text-primary transition-colors">Road Trips</a>
        <span>›</span>
        <span class="text-gray-500">{origin} → {destination}</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 leading-tight mb-5">{title}</h1>
      <p class="text-xl text-gray-500 leading-relaxed mb-8 max-w-2xl">{description}</p>
      <a
        href={plannerUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex flex-wrap items-center gap-x-4 gap-y-2 bg-white border border-gray-200 rounded-xl px-5 py-3 shadow-sm text-sm hover:border-primary/40 hover:shadow-md transition-all"
        data-track="blog_planner_click"
        data-position="hero"
        data-slug={post.slug}
      >
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-primary flex-shrink-0"></span>
          <span class="font-medium text-gray-800">{origin}</span>
        </div>
        <span class="text-gray-300 hidden sm:block">──────</span>
        <span class="text-gray-400 sm:hidden">→</span>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-sunset flex-shrink-0"></span>
          <span class="font-medium text-gray-800">{destination}</span>
        </div>
        {estimatedDriveTime && (
          <>
            <span class="text-gray-200 hidden sm:block">|</span>
            <span class="text-gray-500">{estimatedDriveTime}</span>
          </>
        )}
        {distanceMiles && (
          <>
            <span class="text-gray-200 hidden sm:block">|</span>
            <span class="text-gray-500">{distanceMiles} mi</span>
          </>
        )}
        <span class="text-primary text-xs font-medium ml-1">Open in Navio →</span>
      </a>
    </div>
  </div>

  <article class="max-w-3xl mx-auto px-6 py-12">
    {heroImage && (
      <img
        src={heroImage}
        alt={`Route map: ${origin} to ${destination}`}
        class="w-full aspect-[16/9] object-cover rounded-xl mb-10 shadow-sm"
        width="1280"
        height="640"
        fetchpriority="high"
      />
    )}
    <div class="flex flex-wrap items-center gap-3 mb-10 pb-8 border-b border-gray-100">
      <time datetime={publishDate.toISOString()} class="text-sm text-gray-400">{formattedDate}</time>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map(tag => (
            <span class="px-2.5 py-0.5 rounded-full bg-primary/5 border border-primary/15 text-primary text-xs font-medium">{tag}</span>
          ))}
        </div>
      )}
    </div>
    <div class="prose prose-gray prose-lg max-w-none
      prose-headings:font-display prose-headings:font-bold prose-headings:text-gray-900
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-gray-600 prose-p:leading-relaxed
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-strong:text-gray-900
      prose-li:my-1 prose-li:text-gray-600">
      <Content />
    </div>
    <div class="mt-16 p-8 rounded-2xl border border-primary/15 bg-[radial-gradient(circle_at_top_left,rgba(38,92,75,0.05),transparent_60%)]">
      <p class="font-display font-bold text-2xl text-gray-900 mb-2">Ready to hit the road?</p>
      <p class="text-gray-500 mb-6 max-w-md leading-relaxed">
        Open this route in Navio for vehicle-aware stop suggestions, fuel cost estimates, and one-tap Google Maps handoff.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={plannerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-white bg-primary px-6 py-3 rounded-xl hover:bg-primary/90 transition-colors shadow-sm"
          data-track="blog_planner_click"
          data-position="footer_cta"
          data-slug={post.slug}
        >
          {routeId ? 'Open Route in Navio' : 'Plan This Route in Navio'} →
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 bg-white border border-gray-200 px-6 py-3 rounded-xl hover:border-gray-300 transition-colors"
        >
          More Road Trips
        </a>
      </div>

      {/*
        Android-only Play Store CTA. Hidden by default and revealed by the
        script below — Navio ships on Google Play only, so showing this to
        iOS or desktop readers is a dead end. Kept visually secondary to the
        planner CTA above: that link carries the route's origin and
        destination, so it delivers value immediately, while this one asks
        for an install first.
      */}
      <div id="play-store-cta" hidden class="mt-6 pt-6 border-t border-primary/10">
        <p class="text-sm text-gray-500 mb-3">On Android? Take Navio with you.</p>
        <a
          href={playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 text-sm font-semibold text-primary bg-white border border-primary/30 px-6 py-3 rounded-xl hover:border-primary hover:bg-primary/5 transition-colors"
          data-track="blog_play_store_click"
          data-position="footer_cta"
          data-slug={post.slug}
        >
          <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 0 1 0 1.73l-2.808 1.626L15.09 12l2.608-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
          </svg>
          Get Navio free on Google Play
        </a>
      </div>
    </div>
  </article>

  <script is:inline>
    // Reveal the Play Store CTA only on Android. Static build, so this has to
    // happen client-side; the element ships hidden so no other platform sees it.
    if (/Android/.test(navigator.userAgent)) {
      var playCta = document.getElementById('play-store-cta');
      if (playCta) playCta.hidden = false;
    }
  </script>
</BaseLayout>
