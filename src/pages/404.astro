---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Route Not Found"
  description="The page you are looking for does not exist."
>
  <div class="max-w-3xl mx-auto px-6 py-32 text-center">
    <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-4">404</p>
    <h1 class="font-display text-4xl font-bold text-gray-900 mb-4">Route Not Found</h1>
    <p class="text-lg text-gray-500 mb-10 max-w-md mx-auto leading-relaxed">
      Looks like this road leads nowhere. The page you are looking for does not exist or may have moved.
    </p>
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-sm font-semibold text-white bg-primary px-6 py-3 rounded-xl hover:bg-primary/90 transition-colors shadow-sm"
    >
      ← Back to Road Trips
    </a>
  </div>
</BaseLayout>
